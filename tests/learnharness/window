#!/usr/bin/env bash
set -eu
mkdir -m 700 /tmp/runtime
mkdir -m 1777 /tmp/.X11-unix
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
printf "localhost\n" > /etc/hostname
printf "tester:x:%s:%s:QA:/profile:/bin/sh\n" "$(id -u)" "$(id -g)" > /etc/passwd
printf "tester:x:%s:\n" "$(id -g)" > /etc/group
/Xvfb :71 -screen 0 1280x900x24 -extension GLX -nolisten tcp >/tmp/xlog 2>&1 &
for i in {1..100}; do test -S /tmp/.X11-unix/X71 && break; sleep .05; done
/app/learnharness --disable-gpu --remote-debugging-port=9222 >/tmp/app-log 2>&1 &
pid=$!
for i in {1..400}; do
  kill -0 "$pid" || { head -30 /tmp/xlog; head -c 1000 /tmp/app-log; exit 1; }
  curl -fsS http://127.0.0.1:9222/json/version >/dev/null 2>&1 && break
  sleep .1
done
node /probe.mjs "$1" "$2"
wait "$pid"
