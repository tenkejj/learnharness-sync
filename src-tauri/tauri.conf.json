{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnHarness Sync",
  "version": "0.2.0-alpha.1",
  "identifier": "io.github.tenkejj.learnharness-sync",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LearnHarness Sync",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Unofficial, local-first synchronization companion for LearnHarness",
    "longDescription": "Independent, unofficial LearnHarness companion. Linux desktop for explicitly consented managed-profile synchronization on the tested LearnHarness 0.6.1 release, with encrypted LAN pairing, durable backups and application readback.",
    "targets": ["appimage", "deb", "rpm"],
    "resources": {
      "../LICENSE": "licenses/LearnHarness-Sync-MIT.txt",
      "../NOTICE": "licenses/NOTICE.txt",
      "../public/fonts/OFL-Manrope.txt": "licenses/Manrope-OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "provides": ["harness-sync"],
        "conflicts": ["harness-sync (<< 0.2.0~alpha.1)"],
        "replaces": ["harness-sync (<< 0.2.0~alpha.1)"]
      },
      "rpm": {
        "provides": ["harness-sync"],
        "conflicts": ["harness-sync < 0.2.0"],
        "obsoletes": ["harness-sync < 0.2.0"]
      }
    }
  },
  "mainBinaryName": "learnharness-sync"
}
