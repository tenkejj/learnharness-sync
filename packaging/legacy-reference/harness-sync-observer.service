[Unit]
Description=HarnessSync read-only observer (review WorkingDirectory before installation)
After=graphical-session.target
[Service]
Type=simple
WorkingDirectory=%h/Projects/harness-sync
ExecStart=/usr/bin/python -m harness_sync watch
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
[Install]
WantedBy=default.target
